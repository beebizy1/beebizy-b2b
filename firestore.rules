rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(ownerId) { return isSignedIn() && request.auth.uid == ownerId; }
    function eventOf(eventId) { return get(/databases/$(database)/documents/events/$(eventId)); }
    function isEventOwner(eventId) { return isSignedIn() && eventOf(eventId).data.ownerId == request.auth.uid; }
    function isSharedEvent(eventId) { return eventOf(eventId).data.shareToken != null; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /userSettings/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /events/{eventId} {
      allow read: if isOwner(resource.data.ownerId) || (resource.data.shareToken != null);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isEventOwner(eventId)
        || (isSharedEvent(eventId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
            && request.resource.data.registrationCount == resource.data.registrationCount + 1);
      allow delete: if isEventOwner(eventId);

      // Per-event subcollections: owner-only, except the narrow public read/update
      // exceptions needed for the /buy and /share public pages.
      match /{sub}/{docId} {
        allow read: if isEventOwner(eventId)
          || (isSharedEvent(eventId) && sub in ['ticketTypes', 'checklistItems', 'runOfShowItems']);
        allow create, delete: if isEventOwner(eventId);
        allow update: if isEventOwner(eventId)
          || (sub == 'ticketTypes' && isSharedEvent(eventId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantitySold'])
              && request.resource.data.quantitySold >= resource.data.quantitySold
              && (resource.data.quantityTotal == 0 || request.resource.data.quantitySold <= resource.data.quantityTotal));
      }
      match /raffleItems/{itemId}/raffleTickets/{ticketId} {
        allow read, write: if isEventOwner(eventId);
      }
      match /floorplan/{docId} {
        allow read, write: if isEventOwner(eventId);
      }
    }

    match /locations/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /vendors/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      match /messages/{messageId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/vendors/$(id)).data.ownerId);
      }
    }

    match /attendees/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /registrations/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if (isSignedIn() && request.resource.data.ownerId == request.auth.uid)
        // Public checkout create: ownerId must match the event's real owner (never spoofed),
        // and the event must currently be share-enabled.
        || (request.resource.data.ownerId == eventOf(request.resource.data.eventId).data.ownerId
            && isSharedEvent(request.resource.data.eventId)
            && request.resource.data.status == 'confirmed');
    }

    match /templates/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      match /{sub}/{docId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/templates/$(id)).data.ownerId);
      }
    }

    match /checklists/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /canvases/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /eventRoi/{id} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
