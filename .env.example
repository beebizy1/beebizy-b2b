# Authentication — Clerk, via the Vercel Marketplace.
#
# Provisioned by `vercel integration add clerk`, which writes these into the project's
# environments and into .env.local for local development. You should not need to set them
# by hand; `vercel env pull` refreshes them.
#
# Only the publishable key reaches the browser (see vite.config.ts's envPrefix). The
# secret key is unused by this SPA and must never be exposed to the client.
#
# Without a publishable key the app runs in demo mode: no sign-in, seed data, everything
# works, nothing is saved.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=      # server-side only; not read by the SPA

# Database — Firebase / Firestore.
#
# Separate from sign-in: Clerk handles auth, these would handle persistence. The Firestore
# adapter is not wired yet, so setting them does not switch the app off demo data on its
# own. Tracked in the README.
#
# Find them in the Firebase console under Project settings → General → Your apps →
# SDK setup and configuration → Config. These are client-side keys and are safe to ship
# in a browser bundle; access is controlled by firestore.rules, not by hiding the key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed if your Firestore database has a custom ID rather than "(default)".
# Without it the SDK throws: Database '(default)' not found.
# VITE_FIRESTORE_DATABASE_ID=
