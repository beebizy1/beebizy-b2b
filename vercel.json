{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.ts": { "maxDuration": 300 },
    "api/hubspot-event-sync.ts": {
      "maxDuration": 120,
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "hubspot-event-registrations" }]
    }
  },
  "redirects": [
    {
      "source": "/c",
      "destination": "/check-in/assignment_87e0be1de78a4197a083040bab985016",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!hubspot-event-sync$).*)",
      "destination": "/api/router?__path=$1"
    },
    {
      "source": "/((?!api/)(?!@)(?!.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/fundraising/maintenance",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/notifications/maintenance",
      "schedule": "5 16 * * *"
    },
    {
      "path": "/api/integrations/google-calendar/maintenance",
      "schedule": "10 16 * * *"
    },
    {
      "path": "/api/integrations/hubspot/maintenance",
      "schedule": "15 16 * * *"
    }
  ]
}
